	partition sequential_summary = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database ( PgServer, PgDatabase ),
				    View = Source{[Schema = "bi", Item = "sequential_summary"]}[Data],
				    Typed = Table.TransformColumnTypes ( View, {{"rule", type text}, {"rule_order", Int64.Type}, {"arms_stopped", Int64.Type}, {"wrong_calls", Int64.Type}, {"agrees_with_fixed", Int64.Type}, {"median_days_saved", type number}} )
				in
