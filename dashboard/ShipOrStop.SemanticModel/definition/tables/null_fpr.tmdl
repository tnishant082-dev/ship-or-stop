		lineageTag: 37af8fe8-05ba-5275-a701-7e6541e842b8
		summarizeBy: none
		sourceColumn: false_positive_rate

		annotation SummarizationSetBy = Automatic

	partition null_fpr = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database ( PgServer, PgDatabase ),
				    View = Source{[Schema = "bi", Item = "null_fpr"]}[Data],
				    Typed = Table.TransformColumnTypes ( View, {{"rule", type text}, {"rule_order", Int64.Type}, {"false_positive_rate", type number}} )
