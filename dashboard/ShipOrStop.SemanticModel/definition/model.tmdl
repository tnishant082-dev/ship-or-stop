model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["PgServer", "PgDatabase", "program_kpis", "experiments", "arms", "final_results", "checkpoints", "srm", "srm_trajectory", "null_fpr", "peeking_curve", "sequential_stops", "sequential_summary", "verdict_counts", "decision_sensitivity", "heterogeneity", "eb_shrinkage", "metric_tree", "verdict_segments", "metric_comovement", "metric_sensitivity", "early_read", "dq_checks", "dq_incidents", "layer_rows", "load_audit", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table program_kpis
ref table experiments
ref table arms
ref table final_results
ref table checkpoints
ref table srm
ref table srm_trajectory
ref table null_fpr
ref table peeking_curve
ref table sequential_stops
ref table sequential_summary
ref table verdict_counts
ref table decision_sensitivity
ref table heterogeneity
ref table eb_shrinkage
ref table metric_tree
ref table verdict_segments
ref table metric_comovement
ref table metric_sensitivity
ref table early_read
ref table dq_checks
ref table dq_incidents
ref table layer_rows
ref table load_audit
ref table _Measures
