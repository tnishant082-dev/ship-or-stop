	column Value
		dataType: string
		isHidden
		lineageTag: 80e7b9ff-0e40-52db-8030-bef73a4db404
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW ( "Value", BLANK () )
